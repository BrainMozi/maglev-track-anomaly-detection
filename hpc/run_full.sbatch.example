#!/bin/bash
#SBATCH --job-name=maglev_anomaly
#SBATCH --partition=<GPU_PARTITION>
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=7
#SBATCH --gres=gpu:1
#SBATCH --mem=64G
#SBATCH --time=0-02:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -euo pipefail

# Set these two paths for your cluster. Do not commit private account paths.
PROJECT_ROOT="${PROJECT_ROOT:?export PROJECT_ROOT first}"
PYTHON_BIN="${PYTHON_BIN:-python}"
CONFIG_PATH="${CONFIG_PATH:-configs/local.json}"

cd "$PROJECT_ROOT"
mkdir -p logs outputs

printf 'job=%s host=%s cwd=%s\n' "${SLURM_JOB_ID:-unknown}" "$(hostname)" "$PWD"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader || true

"$PYTHON_BIN" -c "import numpy, scipy, sklearn, cv2, PIL, maxflow; print('deps OK')"
"$PYTHON_BIN" scripts/run_full.py --config "$CONFIG_PATH"

echo "DONE job=${SLURM_JOB_ID:-unknown}"
